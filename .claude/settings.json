{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "preferredNotifChannel": "terminal_bell",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Glass.aiff 2>/dev/null || true",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ]
  }
}
